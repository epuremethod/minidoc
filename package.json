{
  "name": "minidoc",
  "version": "0.0.0",
  "description": "Small documentation website generator",
  "author": "Gaspard Anna Bucher <g.a.bucher@midasum.com>",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "minidoc": "node --experimental-strip-types src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "marked": "^18.0.7",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "source-map": "^0.7.6",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.3"
  }
}
