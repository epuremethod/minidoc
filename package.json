{
  "name": "@epure/minidoc",
  "version": "0.1.0",
  "description": "Small documentation website generator",
  "author": "Gaspard Anna Bucher <g.a.bucher@midasum.com>",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "pnpm typecheck && pnpm test && pnpm test:package",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:package": "pnpm build && node --test test/package.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "marked": "^18.0.7",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "source-map": "^0.7.6",
    "typescript": "5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.3"
  }
}
