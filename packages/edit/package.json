{
  "name": "@minidoc/edit",
  "version": "0.1.0",
  "private": true,
  "description": "A minidoc page as an editor: its markdown read into the tilia editor's blocks, drawn with minidoc's blocks, and written back",
  "author": "Gaspard Anna Bucher <g.a.bucher@midasum.com>",
  "license": "MIT",
  "homepage": "https://minidoc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epuremethod/minidoc.git",
    "directory": "packages/edit"
  },
  "type": "module",
  "files": [
    "src",
    "edit.css",
    "rescript.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rescript build",
    "check": "pnpm test",
    "test": "rescript build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@epure/editor": "link:../../../editor/packages/editor",
    "@minidoc/blocks": "workspace:^",
    "@minidoc/live": "workspace:^",
    "@rescript/runtime": "12.3.1",
    "@tilia/editor": "link:../../../editor/packages/tilia",
    "@tilia/react": "6.0.1",
    "tilia": "6.0.1"
  },
  "peerDependencies": {
    "@rescript/react": "^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@epure/vitest": "^1.1.0",
    "@rescript/react": "0.15.0",
    "jsdom": "^30.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rescript": "12.3.1",
    "vitest": "^3.2.3",
    "yaml": "^2.8.0"
  },
  "main": "./src/Edit.res.mjs"
}
