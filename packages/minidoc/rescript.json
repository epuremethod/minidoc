{
  "name": "@epure/minidoc",
  "namespace": false,
  "sources": [
    {
      "dir": "src",
      "subdirs": false
    },
    {
      "dir": "src/edit",
      "type": "dev"
    }
  ],
  "package-specs": [
    {
      "module": "esmodule",
      "in-source": true
    }
  ],
  "suffix": ".res.mjs",
  "warnings": {
    "number": "-30"
  },
  "jsx": {
    "version": 4
  },
  "dependencies": [
    "sury",
    "tilia"
  ],
  "dev-dependencies": [
    "@epure/blocks",
    "@rescript/react",
    "@epure/editor",
    "@tilia/editor",
    "@tilia/react"
  ]
}
