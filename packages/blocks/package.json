{
  "name": "@minidoc/blocks",
  "version": "0.2.0",
  "description": "Common ::: blocks for minidoc sites: callouts, quotes, flows, plans, screens, sequences, state machines, database models and API calls, written as HTML, and drawn in React by @minidoc/live",
  "author": "Gaspard Anna Bucher <g.a.bucher@midasum.com>",
  "license": "MIT",
  "homepage": "https://minidoc.dev/blocks.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epuremethod/minidoc.git",
    "directory": "packages/blocks"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./blocks.css": "./blocks.css",
    "./themes/*": "./themes/*",
    "./viewer.js": "./viewer.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "blocks.css",
    "viewer.js",
    "themes",
    "rescript.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist lib *.tgz",
    "prebuild": "pnpm clean && rescript build",
    "build": "node esbuild.js",
    "check": "pnpm build && vitest run",
    "prepack": "pnpm build && clean-package",
    "postpack": "clean-package restore",
    "test": "rescript build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rescript/runtime": "12.3.1",
    "markdown-it": "14.3.0",
    "markdown-it-anchor": "9.2.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@epure/vitest": "^1.1.0",
    "@types/node": "^24.0.3",
    "clean-package": "2.2.0",
    "esbuild": "^0.28.1",
    "rescript": "12.3.1",
    "typescript": "5.8.3",
    "vitest": "^3.2.3"
  },
  "clean-package": {
    "remove": [
      "scripts",
      "devDependencies",
      "clean-package"
    ]
  }
}
