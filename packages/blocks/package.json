{
  "name": "@epure/blocks",
  "version": "0.1.0",
  "description": "Common ::: blocks for minidoc sites: callouts, quotes, flows, plans, screens, sequences, state machines, database models and API calls, written as HTML, and drawn in React by @epure/blocks/live",
  "author": "Gaspard Anna Bucher <g.a.bucher@midasum.com>",
  "license": "MIT",
  "homepage": "https://minidoc.dev/blocks.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epuremethod/minidoc.git",
    "directory": "packages/blocks"
  },
  "type": "module",
  "files": [
    "src",
    "blocks.css",
    "live.css",
    "viewer.js",
    "themes",
    "rescript.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rescript build",
    "check": "pnpm test",
    "test": "rescript build && vitest run",
    "test:watch": "vitest",
    "hit": "rescript build && node test/live/hit.mjs"
  },
  "dependencies": {
    "@rescript/runtime": "12.3.1",
    "markdown-it": "14.3.0",
    "markdown-it-anchor": "9.2.0",
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "@rescript/react": "^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@rescript/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@epure/vitest": "^1.1.0",
    "@types/node": "^24.0.3",
    "rescript": "12.3.1",
    "typescript": "5.8.3",
    "vitest": "^3.2.3",
    "@rescript/react": "0.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.0"
  },
  "main": "./src/Blocks.res.mjs",
  "types": "./src/Blocks.res.d.mts",
  "exports": {
    ".": {
      "types": "./src/Blocks.res.d.mts",
      "default": "./src/Blocks.res.mjs"
    },
    "./live": "./src/live/Live.res.mjs",
    "./blocks.css": "./blocks.css",
    "./live.css": "./live.css",
    "./themes/*": "./themes/*",
    "./viewer.js": "./viewer.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  }
}
